{
  "folders": [
    { "path": "projects", "name": "Projects" },
    { "path": "knowledge", "name": "Knowledge" }
  ],

  "settings": {
    "idf.espIdfPath": "/opt/esp-idf",
    "idf.toolsPath": "/root/.espressif/tools",
    "idf.pythonBinPath": "/usr/bin/python3",
    "idf.port": "/dev/ttyUSB0",
    "C_Cpp.default.includePath": [
      "/opt/esp-idf/components/**",
      "${workspaceFolder}/**"
    ]
  },

  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "ESP-IDF: Build",
        "type": "shell",
        "command": "source /opt/esp-idf/export.sh && idf.py build",
        "options": { "cwd": "${input:projectDir}" },
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "ESP-IDF: Flash",
        "type": "shell",
        "command": "source /opt/esp-idf/export.sh && idf.py flash -p ${input:port}",
        "options": { "cwd": "${input:projectDir}" },
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "ESP-IDF: Build & Flash",
        "type": "shell",
        "command": "source /opt/esp-idf/export.sh && idf.py build flash -p ${input:port}",
        "options": { "cwd": "${input:projectDir}" },
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "ESP-IDF: Monitor",
        "type": "shell",
        "command": "source /opt/esp-idf/export.sh && idf.py monitor -p ${input:port}",
        "options": { "cwd": "${input:projectDir}" },
        "presentation": { "reveal": "always", "panel": "dedicated" }
      },
      {
        "label": "ESP-IDF: Flash & Monitor",
        "type": "shell",
        "command": "source /opt/esp-idf/export.sh && idf.py flash monitor -p ${input:port}",
        "options": { "cwd": "${input:projectDir}" },
        "presentation": { "reveal": "always", "panel": "dedicated" }
      },
      {
        "label": "ESP-IDF: Menuconfig",
        "type": "shell",
        "command": "source /opt/esp-idf/export.sh && idf.py menuconfig",
        "options": { "cwd": "${input:projectDir}" },
        "presentation": { "reveal": "always", "panel": "dedicated" }
      },
      {
        "label": "ESP-IDF: Clean",
        "type": "shell",
        "command": "source /opt/esp-idf/export.sh && idf.py fullclean",
        "options": { "cwd": "${input:projectDir}" },
        "presentation": { "reveal": "always", "panel": "shared" }
      }
    ],
    "inputs": [
      {
        "id": "port",
        "type": "promptString",
        "description": "Serial port",
        "default": "/dev/ttyUSB0"
      },
      {
        "id": "projectDir",
        "type": "promptString",
        "description": "Path to ESP-IDF project",
        "default": "${workspaceFolder:Projects}"
      }
    ]
  },

  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug ESP32 (OpenOCD)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder:Projects}/build/${input:appName}.elf",
        "miDebuggerPath": "/root/.espressif/tools/xtensa-esp-elf-gdb/14.2_20240403/xtensa-esp-elf-gdb/bin/xtensa-esp32-elf-gdb",
        "miDebuggerServerAddress": "localhost:3333",
        "stopAtEntry": false,
        "externalConsole": false,
        "serverStarted": "Info : Listening on port 3333",
        "debugServerPath": "openocd",
        "debugServerArgs": "-f interface/esp_usb_jtag.cfg -f target/esp32.cfg"
      }
    ],
    "inputs": [
      {
        "id": "appName",
        "type": "promptString",
        "description": "App binary name (no .elf)",
        "default": "main"
      }
    ]
  },

  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools",
      "ms-vscode.cpptools-themes",
      "espressif.esp-idf-extension",
      "ms-vscode-remote.remote-containers"
    ]
  }
}
